# Скопируйте в .env и вставьте свой API-ключ сервисного аккаунта voice-app.
# Файл .env не попадает в git и не должен никуда пересылаться.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=b1gqk5stlpkbea0mi0da

# Модель AI Studio: yandexgpt-lite/latest (дешевле в ~6 раз) или yandexgpt/latest (Pro)
YANDEX_MODEL=yandexgpt-lite/latest

# Журнал запросов пишется в server/logs/ (можно поменять)
# LOG_DIR=

PORT=3000
