# Настройки выкладки в Yandex Cloud (не секреты). Скопируйте в deploy.env и заполните по docs/deploy-yandex.md.
FOLDER_ID=b1gqk5stlpkbea0mi0da
REGISTRY_ID=
SA_ID=
LOCKBOX_ID=
CONTAINER_NAME=kstati-api
# Адрес контейнера: https://<id>.containers.yandexcloud.net (без / в конце)
PUBLIC_URL=
YDB_DOCAPI_ENDPOINT=
YANDEX_MODEL=yandexgpt-lite/latest
APP_SCHEME=kstati
VK_CLIENT_ID=
# Адрес на подтверждённом в Postbox домене, например noreply@kstati.app. Пусто — письма не уходят
MAIL_FROM=
VOICE_DAILY_LIMIT=30
# Своя модель разбора команд в отдельном контейнере (server/model): адрес контейнера и PROMPT_MODE=tuned.
# Пусто — работает только облачная модель. Ключ OWN_LLM_KEY — в Lockbox
PROMPT_MODE=
# 1 — все команды разбирает только своя модель: без правил сервера и без страховки облачной моделью
OWN_ONLY=
OWN_LLM_URL=
