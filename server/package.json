{
  "name": "kstati-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "test": "tsx test/repeat.ts && tsx test/ideas.ts && tsx test/e2e.ts",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "stats": "tsx scripts/stats.ts",
    "tables": "tsx scripts/ydb-tables.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
