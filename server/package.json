{
  "name": "kstati-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "test": "tsx test/subs.ts && tsx test/repeat.ts && tsx test/ideas.ts && tsx test/lists.ts && tsx test/films.ts && tsx test/feedback.ts && tsx test/duration.ts && tsx test/v2.ts && tsx test/personal.ts && tsx test/e2e.ts",
    "eval": "tsx eval/run.ts",
    "train:data": "tsx train/generate.ts",
    "typecheck": "tsc --noEmit",
    "stats": "tsx scripts/stats.ts",
    "tables": "tsx scripts/ydb-tables.ts",
    "inspect": "tsx scripts/inspect.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0"
  }
}
