<?xml version="1.0" encoding="utf-8"?>
<!-- Строка дела (2×2, 4×2, 4×4): 20 без линий — полоса 2 (поля 4), название 10.5, справа время 9.5 моно (2×2 — день 8.5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kstati_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <ImageView
    android:id="@+id/kstati_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:importantForAccessibility="no"
    android:visibility="gone" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/kstati_strip_a"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/kstati_strip_b"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no"
          android:visibility="gone" />
      </LinearLayout>
    <TextView
      android:id="@+id/kstati_title"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="7dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="@font/kstati_geist_medium"
      android:gravity="center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:singleLine="true"
      android:textSize="10.5dp" />
    <TextView
      android:id="@+id/kstati_time"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginStart="8dp"
      android:fontFamily="@font/kstati_geist_mono_semibold"
      android:gravity="center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textSize="9.5dp" />
  </LinearLayout>
</LinearLayout>
