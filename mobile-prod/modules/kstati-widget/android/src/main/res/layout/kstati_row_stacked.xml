<?xml version="1.0" encoding="utf-8"?>
<!-- Строка 2×2: линия 1 сверху, 40: полоса 2 (поля 6), название 12.5, под ним «день · время» 9 моно -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/kstati_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <ImageView
    android:id="@+id/kstati_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:importantForAccessibility="no" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/kstati_strip_a"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/kstati_strip_b"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no"
          android:visibility="gone" />
      </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="7dp">
      <TextView
        android:id="@+id/kstati_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/kstati_geist_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12.5dp" />
      <TextView
        android:id="@+id/kstati_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/kstati_geist_mono_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textSize="9dp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
