<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1: ближайшее дело (полоса, название в две строки, «день · время») и квадрат REC справа; поля 10, между 8 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToOutline="true">
  <ImageView
    android:id="@+id/kstati_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/kstati_card"
    android:tint="#F4F3EF" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">
    <LinearLayout
      android:id="@+id/kstati_row"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:orientation="horizontal">
      <LinearLayout
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">
        <ImageView
          android:id="@+id/kstati_strip_a"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no" />
        <ImageView
          android:id="@+id/kstati_strip_b"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:importantForAccessibility="no"
          android:visibility="gone" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="7dp">
        <TextView
          android:id="@+id/kstati_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/kstati_geist_medium"
          android:includeFontPadding="false"
          android:lineHeight="13dp"
          android:maxLines="2"
          android:textSize="10.5dp" />
        <TextView
          android:id="@+id/kstati_when"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:fontFamily="@font/kstati_geist_mono_semibold"
          android:includeFontPadding="false"
          android:letterSpacing="0.04"
          android:maxLines="1"
          android:textSize="8dp" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout
      android:id="@+id/kstati_rec_box"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginStart="8dp">
      <include
        layout="@layout/kstati_rec"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
