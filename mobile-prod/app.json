{
  "expo": {
    "name": "Кстати",
    "slug": "kstati-prod",
    "scheme": "kstatiapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ru.kstati.app",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1E1E1E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Кстати",
      "shortName": "Кстати",
      "lang": "ru",
      "favicon": "./assets/icon.png",
      "themeColor": "#1E1E1E",
      "backgroundColor": "#E7E6E1"
    },
    "ios": {
      "bundleIdentifier": "ru.kstati.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен для голосовых команд"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Распознавание речи нужно, чтобы понимать голосовые команды",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as", "com.samsung.android.bixby.agent"]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Календарь нужен, чтобы показать ваши события рядом с делами и перенести их в «Кстати»"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#1E1E1E"
        }
      ],
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D13438"
        }
      ],
      "./plugins/withIpv4First",
      "expo-web-browser",
      "./plugins/withWorkManagerFix",
      "expo-background-task",
      "./plugins/withShareIntent"
    ],
    "icon": "./assets/icon.png"
  }
}
