{
  "expo": {
    "name": "Кстати",
    "slug": "want-watch-plans",
    "scheme": "kstati",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ru.wwp.app",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1E1E1E"
      }
    },
    "ios": {
      "bundleIdentifier": "ru.wwp.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен для голосовых команд"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#1E1E1E"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D13438"
        }
      ],
      "./plugins/withIpv4First",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "ru.wwp.app.widgets",
          "groupIdentifier": "group.ru.wwp.app",
          "widgets": [
            {
              "name": "KstatiWidget",
              "displayName": "Кстати",
              "description": "Ближайшие дела и микрофон",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "configuration": {
                  "title": "Кстати",
                  "parameters": {
                    "mic": {
                      "title": "Микрофон",
                      "type": "boolean",
                      "default": true
                    },
                    "micTone": {
                      "title": "Цвет микрофона",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Как в теме",
                          "value": "auto"
                        },
                        {
                          "name": "Светлый",
                          "value": "light"
                        },
                        {
                          "name": "Тёмный",
                          "value": "dark"
                        }
                      ],
                      "default": "auto"
                    },
                    "bg": {
                      "title": "Фон",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Как в теме",
                          "value": "auto"
                        },
                        {
                          "name": "Светлый",
                          "value": "light"
                        },
                        {
                          "name": "Тёмный",
                          "value": "dark"
                        }
                      ],
                      "default": "auto"
                    },
                    "text": {
                      "title": "Цвет названий",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Как в теме",
                          "value": "auto"
                        },
                        {
                          "name": "Светлый",
                          "value": "light"
                        },
                        {
                          "name": "Тёмный",
                          "value": "dark"
                        }
                      ],
                      "default": "auto"
                    },
                    "time": {
                      "title": "Цвет времени",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Как в теме",
                          "value": "auto"
                        },
                        {
                          "name": "Светлый",
                          "value": "light"
                        },
                        {
                          "name": "Тёмный",
                          "value": "dark"
                        }
                      ],
                      "default": "auto"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Kstati",
              "label": "Кстати",
              "description": "Ближайшие дела и микрофон",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ]
        }
      ],
      "./plugins/withoutPushEntitlement",
      "./plugins/withWorkManagerFix",
      "expo-background-task"
    ],
    "icon": "./assets/icon.png"
  }
}
