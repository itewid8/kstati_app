{
  "expo": {
    "name": "Кстати",
    "slug": "want-watch-plans",
    "scheme": "kstati",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ru.wwp.app",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1E1E1E"
      }
    },
    "ios": {
      "bundleIdentifier": "ru.wwp.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен для голосовых команд"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#1E1E1E"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D13438"
        }
      ],
      "./plugins/withRecordWidget",
      "./plugins/withIpv4First",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "ru.wwp.app.widgets",
          "groupIdentifier": "group.ru.wwp.app",
          "widgets": [
            {
              "name": "KstatiWidget",
              "displayName": "Кстати",
              "description": "Ближайшие дела и микрофон",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Kstati",
              "label": "Кстати",
              "description": "Ближайшие дела и микрофон",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "icon": "./assets/icon.png"
  }
}
