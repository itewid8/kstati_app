<?xml version="1.0" encoding="utf-8"?>
<!-- Как виджет выглядит в списке виджетов (Android 12+) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/kstati_card"
    android:tint="#1E1E1E" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/kstati_pad"
    android:paddingEnd="@dimen/kstati_pad">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kstati_geist"
        android:text="Футбол"
        android:textColor="#E6E6E6"
        android:textSize="14sp" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kstati_geist_mono"
        android:text="18:00"
        android:textColor="#8B8B8B"
        android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="@dimen/kstati_mic"
      android:layout_height="@dimen/kstati_mic"
      android:layout_marginStart="@dimen/kstati_gap">
      <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/kstati_circle"
        android:tint="#E6E6E6" />
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/kstati_mic"
        android:tint="#1E1E1E" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
