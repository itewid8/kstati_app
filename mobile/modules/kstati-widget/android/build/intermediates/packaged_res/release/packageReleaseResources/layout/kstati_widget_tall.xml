<?xml version="1.0" encoding="utf-8"?>
<!-- Высокий виджет: дела сверху во всю ширину, микрофон снизу по центру.
     Список занимает всё, что выше микрофона; не поместившиеся строки просто не видны. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/kstati_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/kstati_card" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/kstati_pad">
    <LinearLayout
      android:id="@+id/kstati_list"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical" />
    <include
      layout="@layout/kstati_mic_button"
      android:layout_width="@dimen/kstati_mic"
      android:layout_height="@dimen/kstati_mic"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="@dimen/kstati_gap" />
  </LinearLayout>
</FrameLayout>
